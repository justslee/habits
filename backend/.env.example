# Mastery Tracker Backend Environment Variables
# Copy this file to .env and fill in values

# Database — local dev uses SQLite; prod uses Postgres on the shared EC2 box:
#   DATABASE_URL=postgresql+psycopg://habits:PASSWORD@localhost:5432/habits
DATABASE_URL=sqlite:///./data/mastery.db

# AWS Secrets Manager — prod pulls keys from this secret at boot (see app/services/secrets.py).
# HABITS_SECRETS_NAME=habits/prod
# HABITS_SECRETS_DISABLED=1   # set locally to skip the AWS lookup entirely

# OAuth redirect base — the public origin providers redirect back to (Whoop, etc.)
OAUTH_REDIRECT_BASE=http://localhost:8000

# OpenAI API key for LLM calls (Responses API). In prod this is delivered via
# AWS Secrets Manager (habits/prod); locally set it here.
OPENAI_API_KEY=your-openai-api-key-here
# Model tiers — REASONING for evaluation/coaching, FAST for high-volume short calls.
HABITS_REASONING_MODEL=gpt-5.6-sol
HABITS_FAST_MODEL=gpt-5.5
# Reasoning effort knobs (optional): low|medium|high for REASONING, none for FAST.
# HABITS_REASONING_EFFORT=low
# HABITS_FAST_REASONING_EFFORT=none

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Timezone for "today" calculations (the prod box is UTC). date.today() honors
# this; absolute timestamps via datetime.utcnow() stay UTC.
TZ=America/New_York

# Security (generate a secure random string for production)
SECRET_KEY=change-me-in-production

# API key for mobile app auth (shared secret)
API_KEY=change-me-to-a-random-string

# Whoop OAuth credentials
WHOOP_CLIENT_ID=your-whoop-client-id
WHOOP_CLIENT_SECRET=your-whoop-client-secret

# Deepgram — speech-to-text for the speaking evaluator (nova-3).
# Replaced self-hosted WhisperX: same word-level timestamps, no GPU/RAM needed.
DEEPGRAM_API_KEY=your-deepgram-api-key
# DEEPGRAM_MODEL=nova-3

# Set to "true" to enable /docs, /redoc, /openapi.json (disable in production)
DEBUG=false

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081,https://habits.looperapp.org

# Notion integration (for Knowledge Base concept seeding)
# Create at https://www.notion.so/my-integrations
NOTION_TOKEN=your-notion-integration-token
NOTION_KB_DATABASE_ID=2f21c525-92e0-803d-8edd-d7627a5e2c0f

# Web search API for research-mode concept seeding (choose one)
# Brave Search: https://brave.com/search/api/ (free: 1000 queries/month)
BRAVE_SEARCH_API_KEY=
# Tavily: https://tavily.com (built for AI agents)
TAVILY_API_KEY=
