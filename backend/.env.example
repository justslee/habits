# Mastery Tracker Backend Environment Variables
# Copy this file to .env and fill in values

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/mastery.db

# Clawdbot LLM integration (localhost only)
CLAWDBOT_URL=http://localhost:18789

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Security (generate a secure random string for production)
SECRET_KEY=change-me-in-production

# API key for mobile app auth (shared secret)
API_KEY=change-me-to-a-random-string

# Whoop OAuth credentials
WHOOP_CLIENT_ID=your-whoop-client-id
WHOOP_CLIENT_SECRET=your-whoop-client-secret

# GraphHopper self-hosted routing engine
GRAPHHOPPER_URL=http://localhost:8989

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081

# Notion integration (for Knowledge Base concept seeding)
# Create at https://www.notion.so/my-integrations
NOTION_TOKEN=your-notion-integration-token
NOTION_KB_DATABASE_ID=2f21c525-92e0-803d-8edd-d7627a5e2c0f

# Web search API for research-mode concept seeding (choose one)
# Brave Search: https://brave.com/search/api/ (free: 1000 queries/month)
BRAVE_SEARCH_API_KEY=
# Tavily: https://tavily.com (built for AI agents)
TAVILY_API_KEY=
