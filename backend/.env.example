# Mastery Tracker Backend Environment Variables
# Copy this file to .env and fill in values

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/mastery.db

# Clawdbot LLM integration (localhost only)
CLAWDBOT_URL=http://localhost:18789

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Security (generate a secure random string for production)
SECRET_KEY=change-me-in-production
