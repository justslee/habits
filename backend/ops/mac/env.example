# Habits API runtime environment for the always-on Mac.
# Lives at ~/Library/Application Support/Habits/env (outside every git checkout).
# Loaded by ops/mac/start-api.sh and deploy.sh.

# Database — defaults to ~/Library/Application Support/Habits/mastery.db if unset.
# DATABASE_URL=sqlite:////Users/you/Library/Application Support/Habits/mastery.db

# Shared secret the mobile app sends as X-API-Key. Keep identical to the value baked
# into the installed TestFlight build or the app stops authenticating.
API_KEY=
SECRET_KEY=

# LLM (OpenAI Responses API) + speech-to-text
OPENAI_API_KEY=
HABITS_REASONING_MODEL=gpt-5.6-sol
HABITS_FAST_MODEL=gpt-5.5
DEEPGRAM_API_KEY=

ALLOWED_ORIGINS=https://justins-macbook-pro-2.tail2c4851.ts.net,http://localhost:8081,http://localhost:19006
TZ=America/New_York
PORT=8000
DEBUG=false

# Optional
NOTION_TOKEN=
NOTION_KB_DATABASE_ID=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
