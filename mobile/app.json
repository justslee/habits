{
  "expo": {
    "name": "Rituals",
    "slug": "mastery-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#11121a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.masterytracker.app",
      "appleTeamId": "X3F694PQ8B",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Habits uses the microphone so you can talk to your coach.",
        "CFBundleDisplayName": "Rituals"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563eb"
        }
      ],
      "expo-secure-store",
      "@config-plugins/react-native-webrtc"
    ],
    "platforms": [
      "ios",
      "web"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "backgroundColor": "#11121a",
      "themeColor": "#bdafe1",
      "name": "Rituals",
      "shortName": "Rituals",
      "description": "Daily rituals, training, food and the long view \u2014 on your own Mac.",
      "display": "standalone",
      "orientation": "portrait"
    },
    "extra": {
      "eas": {
        "projectId": "653e2495-dae4-40b4-9227-1200f157eef5"
      }
    },
    "owner": "jlee627"
  }
}
