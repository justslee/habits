{
  "expo": {
    "name": "Mastery Tracker",
    "slug": "mastery-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.masterytracker.app",
      "appleTeamId": "X3F694PQ8B",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "100.106.81.115": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563eb"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Mastery Tracker to track your runs in the background.",
          "isIosBackgroundLocationEnabled": true
        }
      ]
    ],
    "platforms": [
      "ios",
      "web"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "backgroundColor": "#09090F",
      "themeColor": "#6366F1",
      "name": "Mastery Tracker",
      "shortName": "Mastery",
      "description": "Daily mastery, fitness, and run tracking",
      "display": "standalone",
      "orientation": "portrait"
    },
    "extra": {
      "eas": {
        "projectId": "653e2495-dae4-40b4-9227-1200f157eef5"
      }
    },
    "owner": "jlee627"
  }
}
