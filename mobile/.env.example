# Mastery Tracker Mobile Environment Variables
# Copy this file to .env and fill in values

# Backend API URL (via Cloudflare Tunnel in production)
EXPO_PUBLIC_API_URL=http://localhost:8000

# API key (must match backend API_KEY)
EXPO_PUBLIC_API_KEY=change-me-to-match-backend

# For local development, use your machine's IP:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8000
